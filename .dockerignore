# =============================================================================
# .dockerignore — Royal Land PMS
# Keeps the Docker build context lean and secure.
# Excludes dev tools, secrets, caches, and local artifacts.
# =============================================================================

# ── Secrets — NEVER in image ──────────────────────────────────────────────────
.env
.env.*
*.env
docker/.env
docker/.env.prod
docker/.env.example

# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitlab-ci.yml

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Dev/test artifacts ────────────────────────────────────────────────────────
*.log
*.pot
*.mo
.pytest_cache/
.coverage
htmlcov/
test-results.xml
.ruff_cache/

# ── Local media uploads (not part of image — use volumes) ────────────────────
media/

# ── Collected static (regenerated by collectstatic in entrypoint) ─────────────
staticfiles/

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Docs ──────────────────────────────────────────────────────────────────────
docs/
*.md
LICENSE

# ── Local dev only ────────────────────────────────────────────────────────────
docker/docker-compose.yml
docker/docker-compose.prod.local.yml
requirements.dev.txt
pyproject.toml